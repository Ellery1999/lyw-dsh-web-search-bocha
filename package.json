{
  "name": "@lyw/dsh-web-search-bocha",
  "description": "Bocha-backed WebSearchProvider for DeepSeek Harness, adapted for dsh 0.2.0-rc.1 (removes the removed dsh-settings installSettingsSection API)",
  "version": "0.2.0-rc.1.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.0-rc.1"
  },
  "keywords": [
    "bocha",
    "deepseek-harness",
    "dsh-plugin",
    "web-search"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ellery1999/lyw-dsh-web-search-bocha.git"
  },
  "homepage": "https://github.com/Ellery1999/lyw-dsh-web-search-bocha#readme",
  "bugs": {
    "url": "https://github.com/Ellery1999/lyw-dsh-web-search-bocha/issues"
  },
  "contributors": [
    "Bocha (original @bocha-ai/dsh-web-search-bocha)"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-launch-environment": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-web": "^0.2.0-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
